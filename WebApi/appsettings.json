{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning",
        "Microsoft.Extensions.Diagnostics.HealthChecks": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "PostgreSqlConnection": "",
    "Redis": "localhost:6379"
  },
  "JWTConfiguration": {
    "ValidAudience": "https://i-rieltor.uz",
    "ValidIssuer": "https://i-rieltor.uz",
    "Secret": "",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 14,
    "SessionDays": 30
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Eimzo": {
    "BaseUrl": "http://localhost:8080",
    "SiteHost": "i-rieltor.uz",
    "TimeoutSeconds": 15
  },
  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "EnableSsl": true,
    "UserName": "",
    "Password": "",
    "FromAddress": "",
    "FromName": "I-Rieltor.uz"
  },
  "EmailConfirmation": {
    "LinkBaseUrl": "",
    "TokenHours": 24
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "FileStorage": {
    "RootPath": "wwwroot",
    "PublicBaseUrl": "",
    "MaxFileSizeMb": 20,
    "OrphanCleanupIntervalHours": 24,
    "OrphanMinAgeHours": 24
  },
  "DefaultAdmin": {
    "Email": "admin@example.com",
    "Password": ""
  },
  "RateLimiting": {
    "AuthPermitPerMinute": 10,
    "SessionPermitPerMinute": 30
  },
  "Retention": {
    "IntervalHours": 24,
    "StartDelaySeconds": 600,
    "RefreshTokenDays": 30,
    "DeletedUserDays": 365,
    "DeletedFileDays": 90
  }
}
