# Copy this file to .env and fill in the values. Do not commit .env.
# Keys use "__" as the configuration section separator; real environment variables override .env.

# --- docker compose (docker-compose.yml) ---
# Used by the postgres/redis containers; inside compose the API's connection strings are built from them,
# so the two ConnectionStrings__ lines below matter only for running the API outside compose (dotnet run).
POSTGRES_DB=IRieltor
POSTGRES_USER=irieltor
POSTGRES_PASSWORD=<db-password>
REDIS_PASSWORD=<redis-password>
# Host ports of Nginx
HTTP_PORT=80
HTTPS_PORT=443

# HTTPS (Let's Encrypt): the API's domain (its DNS A record must point at this server, port 80 open)
# and an email for expiry notices. Empty: no certificate, HTTP only (developer machine).
# LETSENCRYPT_STAGING=1 uses Let's Encrypt's test CA for a first try (not trusted by browsers, no rate limits).
SERVER_NAME=api.i-rieltor.uz
LETSENCRYPT_EMAIL=<admin@i-rieltor.uz>
#LETSENCRYPT_STAGING=1

# Daily backups (docker compose "backup" service): host folder, time in UTC (22:00 = 03:00 Tashkent), days kept
#BACKUP_DIR=./backups
#BACKUP_AT_UTC=22:00
#BACKUP_KEEP_DAYS=14

# Error alerts: an email (via the SMTP settings below) when the API logs an error, at most one every 15 minutes
#Alerts__Email=<admin@i-rieltor.uz>

ConnectionStrings__PostgreSqlConnection=Server=localhost;Database=IRieltor;Port=5432;User Id=postgres;Password=<db-password>;
# In production Redis must require a password: localhost:6379,password=<redis-password>
ConnectionStrings__Redis=localhost:6379

# Apply EF migrations when the API starts (default true). Set false when several instances run
# or migrations are applied separately (dotnet ef migrations bundle / CI step).
#Database__MigrateOnStartup=false

# At least 32 bytes. Generate with: openssl rand -base64 64
JWTConfiguration__Secret=<random-secret>

# Gmail requires an App Password (Google account > Security > App passwords)
Smtp__UserName=<sender@gmail.com>
Smtp__Password=<app-password>
Smtp__FromAddress=<sender@gmail.com>

# Own E-IMZO-SERVER in the private network (its /backend endpoints must not be public)
# and the domain registered for the E-IMZO API-KEY
Eimzo__BaseUrl=http://e-imzo-server:8080
Eimzo__SiteHost=i-rieltor.uz

# Browser origins allowed to call the API (web site and admin panel)
Cors__AllowedOrigins__0=https://i-rieltor.uz
Cors__AllowedOrigins__1=https://admin.i-rieltor.uz

# Reverse proxy (Nginx) in front of the API: X-Forwarded-For is trusted only from these addresses.
# docker-compose.yml sets them itself (its Nginx has the fixed address 172.30.0.10). Outside compose name the exact
# proxy address; avoid wide networks such as 172.16.0.0/12, which also contain Docker's own gateways.
# Leave both empty when the proxy runs on the same host (loopback is trusted).
#ForwardedHeaders__KnownProxies__0=10.0.0.5
#ForwardedHeaders__KnownNetworks__0=

# Host names the API answers to (Host header), ';'-separated. The Docker healthcheck uses the first one.
# Keep localhost for running the API locally with this file.
AllowedHosts=api.i-rieltor.uz;localhost

# Public address of this API; file Urls are built as <PublicBaseUrl>/uploads/<category>/<name>
FileStorage__PublicBaseUrl=https://api.i-rieltor.uz
# Folder for uploads/ and deleted/: absolute (a mounted volume) or relative to the app; the Docker image uses /data/files
FileStorage__RootPath=/data/files

# Frontend page opened by the "confirm your email" link; it posts ?token= to POST api/auth/confirm-email
EmailConfirmation__LinkBaseUrl=https://i-rieltor.uz/confirm-email

# SMS through Eskiz (notify.eskiz.uz). Empty: no SMS, only email notifications. "From" is the sender name registered with Eskiz.
#Eskiz__Email=<eskiz-account-email>
#Eskiz__Password=<eskiz-password>
#Eskiz__From=4546

# Payments. A method with empty details is off. Payme and Click call us: give them
# https://<api>/api/payments/payme and https://<api>/api/payments/click/prepare and .../click/complete.
#Payments__ReturnUrl=https://i-rieltor.uz/payment/result
#Payments__Payme__MerchantId=<payme-merchant-id>
#Payments__Payme__Key=<payme-cash-desk-key>
#Payments__Click__ServiceId=<click-service-id>
#Payments__Click__MerchantId=<click-merchant-id>
#Payments__Click__SecretKey=<click-secret-key>
#Payments__BankTransfer__Instructions=<bank details shown to the payer>
#Payments__CardTransfer__Instructions=<card number, holder and purpose text shown to the payer>

# Auctions: how often the clock-driven steps run (start at the start time, result at the end time), in seconds;
# and how many days the winner has for the final payment
#Auctions__LifecycleIntervalSeconds=10
#Auctions__FinalPaymentDays=5
#Auctions__RunnerUpResponseDays=2
#Auctions__PaymentReminderHours=24
#Auctions__StartingSoonMinutes=60

# Personal data retention in days (0 = keep); confirm the periods with your lawyer (ZRU-547)
#Retention__DeletedUserDays=365
#Retention__DeletedFileDays=90
#Retention__RefreshTokenDays=30
#Retention__AuditLogDays=365

# Used to create the SUPER_ADMIN user on first start (min 8 chars, 1 uppercase, 1 digit, 1 symbol)
DefaultAdmin__Email=admin@example.com
DefaultAdmin__Password=<strong-password>
# Swagger UI at /swagger (and /swagger/v1/swagger.json). On by default; false hides it.
#Swagger__Enabled=false
