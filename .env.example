# Copy this file to .env and fill in the values. Do not commit .env.
# Keys use "__" as the configuration section separator; real environment variables override .env.

ConnectionStrings__PostgreSqlConnection=Server=localhost;Database=IRieltor;Port=5432;User Id=postgres;Password=<db-password>;
# In production Redis must require a password: localhost:6379,password=<redis-password>
ConnectionStrings__Redis=localhost:6379

# At least 32 bytes. Generate with: openssl rand -base64 64
JWTConfiguration__Secret=<random-secret>

# Gmail requires an App Password (Google account > Security > App passwords)
Smtp__UserName=<sender@gmail.com>
Smtp__Password=<app-password>
Smtp__FromAddress=<sender@gmail.com>

# Own E-IMZO-SERVER in the private network (its /backend endpoints must not be public)
# and the domain registered for the E-IMZO API-KEY
Eimzo__BaseUrl=http://e-imzo-server:8080
Eimzo__SiteHost=i-rieltor.uz

# Browser origins allowed to call the API (web site and admin panel)
Cors__AllowedOrigins__0=https://i-rieltor.uz
Cors__AllowedOrigins__1=https://admin.i-rieltor.uz

# Public address of this API; file Urls are built as <PublicBaseUrl>/uploads/<category>/<name>
FileStorage__PublicBaseUrl=https://api.i-rieltor.uz

# Used to create the SUPER_ADMIN user on first start (min 8 chars, 1 uppercase, 1 digit, 1 symbol)
DefaultAdmin__Email=admin@example.com
DefaultAdmin__Password=<strong-password>
